# 复制为 .env.local，填入实际配置；不要提交 .env.local。
# 仅服务端使用，不能加 NEXT_PUBLIC_ 前缀。
ZHIPU_API_KEY=
ZHIPU_MODEL=
# 复用小红书正文提取服务，仅服务端读取。
FIRECRAWL_API_KEY=
# 高德 Web服务 API 类型 Key，仅服务端 POI 校验使用，与小程序 Key 独立。
AMAP_WEB_SERVICE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 开发模式可留空（允许 localhost:3000）；生产模式须填写 Web 的精确 origin。
WEB_APP_ORIGIN=
